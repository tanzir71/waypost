{
  "manifest_version": 3,
  "name": "ATS Job Collector",
  "description": "Capture job descriptions and export selected collection dates for the ATS scoring tool.",
  "version": "1.0.0",
  "permissions": ["activeTab", "downloads", "storage"],
  "action": {
    "default_title": "ATS Job Collector",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
