{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "/schemas/job-export.json",
  "title": "Waypost Clipper job export",
  "type": "object",
  "required": ["source", "jobs"],
  "properties": {
    "source": {"enum": ["waypost-clipper", "ats-job-collector-extension"]},
    "version": {"type": "integer", "minimum": 1, "maximum": 1},
    "exportedAt": {"type": "string", "format": "date-time"},
    "jobs": {"type": "array", "minItems": 1, "maxItems": 1000, "items": {
      "type": "object", "required": ["title", "text"],
      "properties": {
        "id": {"type": "string", "maxLength": 200},
        "title": {"type": "string", "minLength": 1, "maxLength": 500},
        "company": {"type": "string", "maxLength": 500},
        "text": {"type": "string", "minLength": 1, "maxLength": 100000},
        "url": {"type": "string", "maxLength": 4000},
        "location": {"type": "string", "maxLength": 500},
        "collectedAt": {"type": "string", "format": "date-time"},
        "source": {"type": "string", "maxLength": 100}
      }
    }}
  }
}
